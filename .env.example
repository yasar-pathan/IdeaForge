# Copy to .env.local and fill with your own values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_GENERATIVE_AI_API_KEY=
# Or use: GEMINI_API_KEY=

# Optional overrides (defaults work for most setups)
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro

# App URL for share links (production: your real domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional dev / limits
# IDEAFORGE_UNLIMITED_ANALYSES=true
# IDEAFORGE_FREE_ANALYSIS_LIMIT=3
